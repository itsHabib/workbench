<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Import desk</title>
<style>:root{color-scheme:light;--ink:#17212b;--muted:#647180;--line:#dbe3ea;--blue:#1769e0;--wash:#f4f7fb;--bad:#a63434;--good:#13795b}*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font:15px/1.5 system-ui,-apple-system,sans-serif}main{max-width:1050px;margin:0 auto;padding:48px 24px}header{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px}h1{font-size:32px;letter-spacing:-.03em;margin:0}h2{font-size:18px;margin:0 0 14px}.sub{color:var(--muted);margin:5px 0 0}.pill{border-radius:99px;background:#e5f3ed;color:var(--good);padding:5px 11px;font-size:13px}.grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:20px}.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:0 5px 18px #1d34420b}textarea{width:100%;min-height:235px;border:1px solid #bcc9d4;border-radius:10px;padding:14px;resize:vertical;font:13px/1.6 ui-monospace,monospace}button{border:0;border-radius:9px;background:var(--blue);color:#fff;font-weight:650;padding:10px 16px;cursor:pointer}button.secondary{background:#e9eff8;color:#20466f}button:disabled{opacity:.5;cursor:wait}.actions{display:flex;align-items:center;gap:10px;margin-top:14px}.hint{color:var(--muted);font-size:13px}.empty{color:var(--muted);padding:30px 0;text-align:center}.stats{display:flex;gap:18px;margin:0 0 18px}.stat b{display:block;font-size:24px}.stat span{color:var(--muted);font-size:12px}.errors{margin:16px 0 0;padding:0;list-style:none}.errors li{border-left:3px solid #d66;padding:7px 10px;margin:7px 0;background:#fff5f5;color:var(--bad);font-size:13px}.records{width:100%;border-collapse:collapse;font-size:13px}.records th,.records td{text-align:left;border-bottom:1px solid var(--line);padding:8px 5px}.history{grid-column:1/-1}.history-row{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding:12px 0;font-size:13px}.history-row span{color:var(--muted)}@media(max-width:720px){main{padding:28px 15px}.grid{grid-template-columns:1fr}header{align-items:start;gap:12px;flex-direction:column}.history{grid-column:auto}}</style></head>
<body><main><header><div><h1>Import desk</h1><p class="sub">Check a small CSV before it enters your records.</p></div><span class="pill">Local only</span></header>
<div class="grid"><section class="card"><h2>Upload records</h2><textarea id="csv" spellcheck="false">id,name,email
1001,Alex Chen,alex@example.com
1002,Sam Lee,sam@example.com</textarea><div class="actions"><input id="file" type="file" accept=".csv,text/csv"><button id="submit">Validate import</button><span class="hint" id="notice"></span></div></section>
<section class="card" id="result"><h2>Latest result</h2><div class="empty">Submit a CSV to see its records and any rows to fix.</div></section>
<section class="card history"><h2>Recent imports</h2><div id="history"><div class="empty">No imports yet.</div></div></section></div></main>
<script>
const csv=document.querySelector('#csv'),file=document.querySelector('#file'),submit=document.querySelector('#submit'),result=document.querySelector('#result'),history=document.querySelector('#history'),notice=document.querySelector('#notice');
file.onchange=async()=>{const f=file.files[0];if(f)csv.value=await f.text()};
submit.onclick=async()=>{submit.disabled=true;notice.textContent='Checking…';try{const r=await fetch('/imports',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({csv:csv.value})});const x=await r.json();if(!r.ok)throw Error(x.error);await show(x.id);await refresh()}catch(e){notice.textContent=e.message}finally{submit.disabled=false}};
async function show(id){const r=await fetch('/imports/'+encodeURIComponent(id)),x=await r.json();if(!r.ok)throw Error(x.error);const errors=x.errors||[];result.innerHTML='<h2>Latest result</h2><div class="stats"><div class="stat"><b>'+x.records.length+'</b><span>valid records</span></div><div class="stat"><b>'+errors.length+'</b><span>rows to fix</span></div></div>'+(errors.length?'<ul class="errors">'+errors.map(e=>'<li>Row '+e.row+': '+esc(e.message)+'</li>').join('')+'</ul>':'<p style="color:var(--good)">Every row passed validation.</p>')+(x.records.length?'<table class="records"><thead><tr><th>ID</th><th>Name</th><th>Email</th></tr></thead><tbody>'+x.records.map(r=>'<tr><td>'+esc(r.id)+'</td><td>'+esc(r.name)+'</td><td>'+esc(r.email)+'</td></tr>').join('')+'</tbody></table>':'')+(errors.length?'<div class="actions"><button class="secondary" onclick="focusEditor()">Fix and retry</button></div>':'')}
function focusEditor(){csv.focus();csv.select();csv.scrollIntoView({behavior:'smooth',block:'center'})}
async function refresh(){const x=await (await fetch('/imports')).json();history.innerHTML=x.imports.length?x.imports.map(i=>'<div class="history-row"><span>'+i.id+' · '+i.status+'</span><span>'+i.record_count+' valid · '+i.error_count+' errors</span></div>').join(''):'<div class="empty">No imports yet.</div>';notice.textContent='Import saved'}
function esc(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}refresh();
</script></body></html>
