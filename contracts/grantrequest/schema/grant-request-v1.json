{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/grantrequest/schema/grant-request-v1.json",
  "x-version": "grant-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "request"],
  "properties": {
    "schema_version": {"const": "grant-request.v1"},
    "authorization_id": {"type": "string", "pattern": "^gau_[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "action", "max_tier", "max_cycles", "issued_at", "expires_at"],
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "number", "head_sha"],
          "properties": {
            "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "number": {"type": "integer", "minimum": 1},
            "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "action": {"const": "merge"},
        "max_tier": {"const": "T0"},
        "max_cycles": {"const": 3},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
