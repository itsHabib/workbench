{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/automode/schema/auto-decision-v1.json",
  "title": "AutoDecisionV1",
  "x-version": "auto-decision.v1",
  "$ref": "#/$defs/decision",
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["schema_version", "outcome", "rule_fired", "rulebook_version", "remedy", "harness", "inputs", "action_digest"],
      "properties": {
        "schema_version": { "const": "auto-decision.v1" },
        "outcome": { "type": "string", "enum": ["pass", "park", "block", "refuse"] },
        "rule_fired": { "type": "string", "minLength": 1 },
        "rulebook_version": { "type": "string", "minLength": 1 },
        "remedy": { "type": "string" },
        "harness": { "type": "string", "minLength": 1 },
        "inputs": { "$ref": "#/$defs/inputs" },
        "action_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "pass" } },
            "required": ["outcome"]
          },
          "else": {
            "properties": { "remedy": { "minLength": 1 } }
          }
        }
      ],
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "required": ["action", "observables"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "observables": { "$ref": "#/$defs/values" }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "description": "A parsed semantic operation; opaque command text is not persisted.",
      "required": ["envelope", "operation", "parameters"],
      "properties": {
        "envelope": { "$ref": "#/$defs/name" },
        "operation": { "$ref": "#/$defs/name" },
        "parameters": { "$ref": "#/$defs/values" }
      },
      "additionalProperties": true
    },
    "values": {
      "type": "array",
      "items": { "$ref": "#/$defs/value" }
    },
    "value": {
      "type": "object",
      "required": ["name", "value", "redacted"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "value": { "type": "string" },
        "redacted": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "redacted": { "const": true } },
            "required": ["redacted"]
          },
          "then": {
            "properties": { "value": { "const": "[REDACTED]" } }
          },
          "else": {
            "properties": { "value": { "not": { "const": "[REDACTED]" } } }
          }
        }
      ],
      "additionalProperties": true
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    }
  }
}
