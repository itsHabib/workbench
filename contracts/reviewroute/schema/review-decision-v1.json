{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/reviewroute/schema/review-decision-v1.json",
  "title": "ReviewDecisionV1",
  "type": "object",
  "required": ["schema_version", "generated_at", "subject", "plan_id", "cycle", "continuation_weight", "cumulative_weight", "action", "reason_codes", "next_reviewers", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "required": ["repo", "number", "head_sha"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      },
      "additionalProperties": false
    },
    "plan_id": { "type": "string", "pattern": "^rp_[0-9a-f]{32}$" },
    "cycle": { "type": "integer", "minimum": 1, "maximum": 8 },
    "continuation_weight": { "type": "integer", "minimum": 1 },
    "cumulative_weight": { "type": "integer", "minimum": 1 },
    "action": { "enum": ["stop", "continue", "escalate", "park"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": { "type": "array" }
  },
  "additionalProperties": false
}
