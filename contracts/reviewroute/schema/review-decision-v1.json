{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/reviewroute/schema/review-decision-v1.json",
  "title": "ReviewDecisionV1",
  "type": "object",
  "required": ["schema_version", "generated_at", "subject", "plan_id", "input_digest", "route_disposition", "cycle", "continuation_weight", "cumulative_weight", "action", "reason_codes", "next_reviewers", "adversarial_evidence", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "required": ["repo", "number", "head_sha"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$" },
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "plan_id": { "type": "string", "pattern": "^rp_[0-9a-f]{32}$" },
    "input_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "route_disposition": { "enum": ["tier_routed", "deliberately_overridden", "full_panel_fallback", "parked_unverified"] },
    "route_reason": { "type": "string", "minLength": 1 },
    "tier": { "enum": ["T0", "T1", "T2", "T3"] },
    "tier_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cycle": { "type": "integer", "minimum": 1, "maximum": 8 },
    "continuation_weight": { "type": "integer", "minimum": 1 },
    "cumulative_weight": { "type": "integer", "minimum": 1 },
    "action": { "enum": ["stop", "continue", "address", "escalate", "park"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "adversarial_evidence": {
      "type": ["object", "null"],
      "required": ["subject", "source", "result", "confidence", "artifact_digest"],
      "properties": {
        "subject": {
          "type": "object",
          "required": ["repo", "number", "head_sha"],
          "properties": {
            "repo": { "type": "string", "pattern": "^[a-z0-9._-]+/[a-z0-9._-]+$" },
            "number": { "type": "integer", "minimum": 1 },
            "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          },
          "additionalProperties": false
        },
        "source": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "escalate"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "reviewers", "disposition", "changed", "reviewer_closed", "debt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "minLength": 1 },
          "reviewers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "disposition": { "enum": ["fixed", "proved_safe", "deferred", "unresolved"] },
          "changed": { "type": "boolean" },
          "reviewer_closed": { "type": "boolean" },
          "proof_ref": { "type": "string" },
          "defer_reason": { "type": "string" },
          "debt": { "type": "boolean" },
          "follow_up_ref": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "disposition": { "const": "proved_safe" } },
              "required": ["disposition"]
            },
            "then": {
              "anyOf": [
                {
                  "properties": { "reviewer_closed": { "const": true } },
                  "required": ["reviewer_closed"]
                },
                {
                  "properties": { "proof_ref": { "type": "string", "minLength": 1 } },
                  "required": ["proof_ref"]
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "address" } },
        "required": ["action"]
      },
      "then": {
        "properties": { "next_reviewers": { "minItems": 1 } }
      }
    }
  ],
  "additionalProperties": false
}
