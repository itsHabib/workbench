{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/reviewroute/schema/review-request-v1.json",
  "title": "ReviewRequestV1",
  "type": "object",
  "required": ["schema_version", "generated_at", "subject", "plan_id", "head_before", "head_after", "status", "requests"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "required": ["repo", "number", "head_sha"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      },
      "additionalProperties": false
    },
    "plan_id": { "type": "string", "pattern": "^rp_[0-9a-f]{32}$" },
    "head_before": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "head_after": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "status": { "enum": ["requested", "stale", "failed"] },
    "reason": { "type": "string", "minLength": 1 },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewer", "trigger", "status"],
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "trigger": { "enum": ["mention", "reviewer-request", "auto"] },
          "status": { "enum": ["requested", "observed", "failed"] },
          "ref": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
