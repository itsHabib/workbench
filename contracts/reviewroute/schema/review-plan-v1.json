{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/reviewroute/schema/review-plan-v1.json",
  "title": "ReviewPlanV1",
  "type": "object",
  "required": ["schema_version", "plan_id", "generated_at", "subject", "disposition", "reviewers", "required", "max_cycles", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "pattern": "^rp_[0-9a-f]{32}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "subject": { "$ref": "#/$defs/subject" },
    "disposition": { "enum": ["tier_routed", "deliberately_overridden", "full_panel_fallback", "parked_unverified"] },
    "reason": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "required": ["tier", "reasons"],
      "properties": {
        "tier": { "enum": ["T0", "T1", "T2", "T3"] },
        "reasons": { "$ref": "#/$defs/names" }
      },
      "additionalProperties": false
    },
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reviewer" }
    },
    "required": { "$ref": "#/$defs/names" },
    "max_cycles": { "type": "integer", "minimum": 1, "maximum": 8 },
    "requirements": { "$ref": "#/$defs/requirements" }
  },
  "additionalProperties": false,
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["repo", "number", "head_sha"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": ["name", "trigger"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "trigger": { "enum": ["mention", "reviewer-request", "auto"] }
      },
      "additionalProperties": false
    },
    "names": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirements": {
      "type": "object",
      "required": ["coordinator", "local_adversarial", "adversarial_verification", "allow_proof_substitution"],
      "properties": {
        "coordinator": { "enum": ["none", "on-findings", "required"] },
        "local_adversarial": { "type": "boolean" },
        "adversarial_verification": { "type": "boolean" },
        "allow_proof_substitution": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
