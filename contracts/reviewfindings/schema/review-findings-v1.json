{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/reviewfindings/schema/review-findings-v1.json",
  "title": "ReviewFindingsV1",
  "type": "object",
  "required": ["schema_version", "artifact_id", "decision", "subject", "producer", "panel", "findings"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_id": { "$ref": "#/$defs/id" },
    "decision": { "const": "address" },
    "subject": {
      "type": "object",
      "required": ["type", "repo", "number", "head_sha"],
      "properties": {
        "type": { "const": "pull_request" },
        "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 1024 },
        "number": { "type": "integer", "minimum": 1 },
        "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "required": ["id", "harness", "generated_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "harness": { "$ref": "#/$defs/id" },
        "generated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "panel": {
      "type": "object",
      "required": ["requested", "completed", "missing"],
      "properties": {
        "requested": { "$ref": "#/$defs/panel" },
        "completed": { "$ref": "#/$defs/panel" },
        "missing": { "$ref": "#/$defs/panel" }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary", "evidence", "sources"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "severity": { "$ref": "#/$defs/id" },
          "summary": { "type": "string", "minLength": 1, "x-maxBytes": 512 },
          "evidence": { "type": "string", "minLength": 1, "x-maxBytes": 32768 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["reviewer", "comment_id", "url"],
              "properties": {
                "reviewer": { "$ref": "#/$defs/id" },
                "comment_id": { "$ref": "#/$defs/id" },
                "url": { "type": "string", "format": "uri", "x-maxBytes": 2048 },
                "file": { "type": "string", "minLength": 1, "x-maxBytes": 1024 },
                "line": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "x-maxBytes": 128 },
    "panel": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
