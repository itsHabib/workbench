{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsHabib/workbench/contracts/gateauthorization/schema/gate-execution-result-v1.json",
  "title": "GateExecutionResultV1",
  "type": "object",
  "required": [
    "schema_version", "execution_id", "claim_id", "outcome",
    "merge_argv", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_id": { "type": "string", "pattern": "^gxe_[0-9a-f]{64}$" },
    "claim_id": { "type": "string", "pattern": "^gxc_[0-9a-f]{64}$" },
    "outcome": { "enum": ["merged", "failed"] },
    "merge_argv": {
      "$ref": "gate-authorization-request-v1.json#/$defs/merge_argv"
    },
    "completed_at": { "type": "string", "format": "date-time" },
    "merge_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "error_code": { "type": "string", "minLength": 1 }
  }
}
